# =============================================================================
# Rizoma — configuração de exemplo. Copie para .env e ajuste.
#   cp .env.example .env
# Nenhum valor aqui é segredo real. Não comite o .env.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Fora do Compose (rodando a API no host) use localhost.
# O docker-compose.yml sobrescreve POSTGRES_HOST=postgres para os containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rizoma

# --- Papel 1: DONO DO SCHEMA -------------------------------------------------
# Roda as migrations do Alembic (CREATE TABLE, CREATE EXTENSION, CREATE ROLE).
# Em dev é superusuário. NÃO é usado pelo runtime da API.
POSTGRES_USER=api_user
POSTGRES_PASSWORD=changeme

# --- Papel 2: RUNTIME DA API -------------------------------------------------
# É com este papel que a API atende requisição. Precisa ser NOSUPERUSER e
# NOBYPASSRLS: no Postgres, superusuário IGNORA Row-Level Security em silêncio —
# a policy continua lá, só não vale nada, e o isolamento entre organizações vira
# ficção. Este papel é criado pela própria migration baseline. (ADR-007)
APP_DB_USER=rizoma_app
APP_DB_PASSWORD=rizoma_app_pw

# --- Papel 3: SISTEMA (BYPASSRLS) --------------------------------------------
# Só para o que é legitimamente cross-organização: o login (achar o usuário
# antes de saber a org dele), o reaper de jobs órfãos e a verificação pública de
# laudo. Não existe "GUC de bypass" — qualquer usuário pode setar um GUC
# customizado; por isso o bypass tem de ser um ATRIBUTO DE PAPEL. (ADR-007)
SYSTEM_DB_USER=rizoma_system
SYSTEM_DB_PASSWORD=rizoma_system_pw

# -----------------------------------------------------------------------------
# Object storage — MinIO / S3 (ADR-001)
# -----------------------------------------------------------------------------
# São DOIS endpoints, e confundi-los é a causa nº 1 de 403 no upload:
#
#   S3_ENDPOINT         -> quem usa é a API (servidor). Na rede do Compose o
#                          MinIO atende em http://minio:9000.
#   S3_PUBLIC_ENDPOINT  -> vai ASSINADO dentro da presigned URL. Quem faz o
#                          PUT/GET é o BROWSER, que não resolve o nome 'minio'.
#                          A assinatura V4 cobre o header Host, então assinar com
#                          o host interno e acessar pelo externo => 403.
#
# Rodando a API no host, os dois são http://localhost:9000.
#
# Em produção AWS (S3 nativo, ver docs/DEPLOY_AWS.md): deixe os DOIS endpoints
# e AS DUAS chaves VAZIOS. Aí o boto3 usa o endpoint regional do S3 e pega as
# credenciais da IAM role da task ECS — nenhuma chave estática em produção.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rizoma
S3_SECRET_KEY=rizoma123
S3_BUCKET=rizoma
S3_REGION=us-east-1

# Validade da URL assinada, em segundos.
PRESIGN_EXPIRY_SECONDS=3600
# Teto de upload: FASTQ chega fácil a alguns GB (20 GB por padrão).
MAX_UPLOAD_SIZE_MB=20480

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# E-mail transacional (convites) — Resend
# -----------------------------------------------------------------------------
# Vazio = envio desabilitado (o convite ainda é criado no banco normalmente).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rizoma <convites@mail.flipafile.com>
APP_PUBLIC_URL=https://rizoma.flipafile.com

# -----------------------------------------------------------------------------
# Auth — só Google OAuth, sem senha (ADR-005)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-isto-por-uma-string-aleatoria-longa
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Só emails deste domínio entram.
ALLOWED_EMAIL_DOMAIN=@ufvjm.edu.br

# Segredo compartilhado com o worker para ele se autenticar na API (callback de
# progresso/resultado). Gere com: openssl rand -hex 32
WORKER_TOKEN=troque-isto-tambem

# -----------------------------------------------------------------------------
# Fila de jobs (Postgres LISTEN/NOTIFY — sem Redis, sem Celery)
# -----------------------------------------------------------------------------
# Job cujo worker não bate heartbeat há N segundos volta para a fila.
JOB_HEARTBEAT_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Elasticsearch: REMOVIDO. Busca agora é Postgres FTS + pg_trgm (ADR-003).
# -----------------------------------------------------------------------------
